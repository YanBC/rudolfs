{
  "openapi": "3.1.0",
  "info": {
    "title": "Rudolfs discovery API",
    "version": "1.0.0",
    "description": "Persisted LFS namespaces, not Git code repositories. No built-in authentication. Protect all routes at deployment. Scan limit: 100,000 objects / 30 seconds. Pagination is not a snapshot; see docs/http-api.md."
  },
  "paths": {
    "/api/v1/repositories": {
      "get": {
        "operationId": "listRepositories",
        "summary": "List permanent LFS namespaces sorted by organization then repository",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "",
              "description": "Case-insensitive substring of organization/repository, at most 200 UTF-8 bytes."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete scan; paginated matching results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepositoryList"
                }
              }
            }
          },
          "400": {
            "description": "invalid_query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed; Allow: GET",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "storage_unavailable, inventory_limit_exceeded, or inventory_timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "Retrieve this contract",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "invalid_query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed; Allow: GET",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/storage/audit": {
      "get": {
        "operationId": "auditStorage",
        "summary": "Compare local SQLite expectations with permanent files",
        "description": "Read-only presence and size check. Does not hash contents, import objects, remove records, or repair files. Limited to 100,000 records and 100,000 current objects / 30 seconds. Remote backends are unsupported. Each page performs a fresh scan; concurrent writes can change results.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "",
              "description": "Case-insensitive substring of organization/repository, at most 200 UTF-8 bytes."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete presence and size audit; paginated issues",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageAudit"
                }
              }
            }
          },
          "400": {
            "description": "invalid_query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed; Allow: GET",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "audit_unavailable: backend has no durable local inventory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "storage_unavailable, inventory_limit_exceeded, or inventory_timeout; no partial results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Repository": {
        "type": "object",
        "required": [
          "organization",
          "repository",
          "object_count",
          "size_bytes",
          "lfs_url"
        ],
        "properties": {
          "organization": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "lfs_url": {
            "type": "string",
            "format": "uri"
          },
          "object_count": {
            "type": "integer",
            "minimum": 0
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "RepositoryList": {
        "type": "object",
        "required": [
          "repositories",
          "pagination"
        ],
        "properties": {
          "repositories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Repository"
            }
          },
          "pagination": {
            "type": "object",
            "required": [
              "limit",
              "offset",
              "total",
              "next"
            ],
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "next": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Relative next-page URL, or null."
              }
            }
          }
        }
      },
      "StorageIssue": {
        "type": "object",
        "required": [
          "organization",
          "repository",
          "oid",
          "status",
          "expected_size_bytes",
          "actual_size_bytes"
        ],
        "properties": {
          "organization": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "oid": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "missing",
              "size_mismatch"
            ]
          },
          "expected_size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "actual_size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "StorageAudit": {
        "type": "object",
        "required": [
          "tracked_objects",
          "issues",
          "pagination"
        ],
        "properties": {
          "tracked_objects": {
            "type": "integer",
            "minimum": 0,
            "description": "All objects in SQLite, before the q filter."
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StorageIssue"
            }
          },
          "pagination": {
            "type": "object",
            "required": [
              "limit",
              "offset",
              "total",
              "next"
            ],
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "next": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Relative next-page URL, or null."
              }
            }
          }
        }
      }
    }
  }
}
